<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Students</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>All Students</h1>

    <a href="/students/new" class="btn">Add New Student</a>

    <% if (students.length === 0) { %>
        <p>No students found. Add one to get started!</p>
    <% } else { %>
        <ul>
            <% students.forEach(student => { %>
                <li>
                    <a href="/students/<%= student._id %>"><%= student.name %></a>


                    <!-- delete should be a form, links can only send GET  -->
                    <form method="POST"
                          action="/students/<%= student._id %>/delete"
                          onsubmit="return confirm('Delete <%= student.name %>?')"
                          style="display:inline">  
                          <button type="submit" class="delete">Delete</button>
                       
                    </form>
                </li>
            <% }) %>
        </ul>
    <% } %>
</body>
</html>
